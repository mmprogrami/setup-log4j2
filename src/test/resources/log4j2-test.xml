<?xml version="1.0"?>
<Configuration status="WARN" monitorInterval="0">
  <Properties>
    <!--Property name="pattern" value="%d{ISO8601}&#x09;%highlight{%5.5p}&#x09;%C{1}&#x09;%M.%L&#x09;%m%n"/-->
    <Property name="pattern" value="%d{HH:mm:ss.SS} %highlight{%5.5p}&#x09;%C{1}&#x09;%M.%L&#x09;%m%n"/>
    <Property name="effective_pattern" value="${sys:log4j2.pattern:-${pattern}}" />
    <Property name="log4j2_stdout_level" value="${sys:log4j2.stdout.level:-INFO}" />
  </Properties>
  <Appenders>
    <Console name="stdout" target="SYSTEM_OUT">
      <LevelRangeFilter
        maxLevel="${log4j2_stdout_level}"
        minLevel="INFO"
        onMatch="ACCEPT"
        onMismatch="DENY"/>
      <PatternLayout pattern="${effective_pattern}" disableAnsi="false" />
    </Console>
    <Console name="stderr" target="SYSTEM_ERR">
      <LevelRangeFilter
        maxLevel="WARN"
        minLevel="FATAL"
        onMatch="ACCEPT"
        onMismatch="DENY"/>
      <PatternLayout pattern="${effective_pattern}" disableAnsi="false" />
    </Console>
  </Appenders>
  <Loggers>
    <Logger name="net.jqwik.engine.JqwikConfiguration" level="WARN" />
    <Root level="${sys:log4j2.root.level:-TRACE}">
      <AppenderRef ref="stdout"/>
      <AppenderRef ref="stderr" />
    </Root>
  </Loggers>
</Configuration>
